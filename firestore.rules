rules_version = '2';

/**
 * CHAZTER — Cloud Firestore security rules
 * ============================================================================
 * Principles:
 *   1. Deny by default. Every allow is explicit and narrow.
 *   2. Membership is checked server-side for every conversation read/write.
 *   3. Users may only write their own profile, and only fields they own.
 *   4. Username claims are immutable in ownership: you can only create a claim
 *      for yourself, and you cannot delete someone else's claim.
 *   5. Messages are append-only for members; only the sender (or a group
 *      admin, for moderation) may delete. Message fields are validated so a
 *      client cannot impersonate another sender or forge a timestamp.
 *   6. Read cursors + typing docs are private-ish: any member can read them
 *      (needed for receipts/typing), but only the owner can write.
 *
 * Deploy:  firebase deploy --only firestore:rules
 * ============================================================================
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- *
     * Helpers
     * ---------------------------------------------------------------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /** Shape check for a usernames/{lowercase} key (defence in depth). */
    function isValidUsernameKey(key) {
      return key.matches('^[a-z0-9][a-z0-9._-]{2,23}$');
    }

    /** True if the caller is listed as a member of the given conversation. */
    function isMember(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isAdminOf(conversationId) {
      return isMember(conversationId)
        && uid() in conversationData(conversationId).admins;
    }

    /** Only these profile keys may ever be written by a client. */
    function validProfileFields(data) {
      return data.keys().hasOnly([
        'uid', 'username', 'usernameLower', 'displayName', 'email', 'photoURL', 'bio',
        'provider', 'createdAt', 'updatedAt', 'onboardingComplete', 'presence',
        'lastReadAt', 'settings', 'displayNameLower',
        // The most recent invite this user redeemed. Bounded and short; it
        // exists so a self-join can be authorised without a query, and it is
        // never trusted for anything except that check.
        'lastInviteCode'
      ]);
    }

    /** True when the new member list is exactly the old one plus the caller. */
    function clientAddsOnlySelf(before, after) {
      return after.toSet() == before.toSet().union([uid()].toSet())
        && after.size() == before.size() + 1;
    }

    /**
     * A usable server invite: exists, not revoked, not expired (always null by
     * design), and aimed at this server. The invite document is the bearer
     * token that authorises a join.
     */
    function isUsableServerInvite(code, serverId) {
      return isSignedIn()
        && code is string
        && code.size() >= 8
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.targetId == serverId
        && get(/databases/$(database)/documents/invites/$(code)).data.type == 'server'
        && get(/databases/$(database)/documents/invites/$(code)).data.revoked == false;
    }

    /** A usable group invite: live, and naming this conversation. */
    function isUsableGroupInvite(code, conversationId) {
      return isSignedIn()
        && code is string
        && code.size() >= 8
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.targetId == conversationId
        && get(/databases/$(database)/documents/invites/$(code)).data.type == 'group'
        && get(/databases/$(database)/documents/invites/$(code)).data.revoked == false;
    }

    /** An admin removing someone else, never the owner. */
    function adminRemovesMember(serverId, memberId) {
      return isServerAdmin(serverId)
        && memberId != uid()
        && exists(/databases/$(database)/documents/servers/$(serverId)/members/$(memberId))
        && get(/databases/$(database)/documents/servers/$(serverId)/members/$(memberId)).data.role != 'owner';
    }

    function validPresence(presence) {
      return presence.keys().hasOnly(['state', 'lastActiveAt'])
        && presence.state in ['online', 'away', 'offline'];
    }

    /* ---------------------------------------------------------------- *
     * Users
     * ---------------------------------------------------------------- */
    match /users/{userId} {
      // Any signed-in user can read a profile (needed for names/avatars in
      // chats and for people search). Emails are visible to members only in
      // practice because the UI never renders other people's email.
      allow read: if isSignedIn();

      // Create: only your own profile document, with a complete, sane shape.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validProfileFields(request.resource.data)
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.onboardingComplete == true
        && (!request.resource.data.keys().hasAny(['presence'])
            || validPresence(request.resource.data.presence));

      // Update: only your own profile. Identity fields are immutable; the
      // username claim can only change together with a claim document write,
      // which the usernames rule enforces separately.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && validProfileFields(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAny(['presence'])
            || validPresence(request.resource.data.presence))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160;

      // Deleting your own profile is allowed (account deletion). Only the
      // owner can do it; messages stay behind intentionally.
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    /* ---------------------------------------------------------------- *
     * Username claims — the uniqueness registry
     * ---------------------------------------------------------------- */
    match /usernames/{usernameLower} {
      // Readable by signed-in users (needed for availability checks + search).
      allow get, list: if isSignedIn();

      // Claim: only for yourself, and the key must match the normalised
      // username exactly. `create` fails if the document already exists,
      // which is what makes duplicates impossible under concurrency.
      allow create: if isSignedIn()
        && isValidUsernameKey(usernameLower)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt'])
        && request.resource.data.uid == uid()
        && request.resource.data.usernameLower == usernameLower
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.lower() == usernameLower;

      // You may replace *your own* claim (used when renaming). The existing
      // document must already belong to you.
      allow update: if isSignedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.usernameLower == usernameLower;

      // You may release only your own claim.
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }


    /* ---------------------------------------------------------------- *
     * Servers — communities with named channels
     * ---------------------------------------------------------------- *
     * A server's membership list is the source of truth for access. Channel
     * membership is denormalised for query efficiency, but it is only ever
     * granted by an admin (or by joining through a valid invite).
     */
    function serverData(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)).data;
    }

    function isServerMember(serverId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/servers/$(serverId))
        && uid() in serverData(serverId).memberIds;
    }

    function serverMemberExists(serverId) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/members/$(uid()));
    }

    function serverRole(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)/members/$(uid())).data.role;
    }

    function isServerAdmin(serverId) {
      // The `exists` guard matters: calling `.data` on a missing document
      // makes the whole rule evaluation error, and an error is not the same
      // as a clean deny - it can surface as an opaque failure to the client.
      return isServerMember(serverId)
        && serverMemberExists(serverId)
        && serverRole(serverId) in ['owner', 'admin'];
    }

    match /servers/{serverId} {
      // Only members may see a server. Invite previews deliberately do NOT
      // expose server data: the join screen shows the name from the invite
      // document alone, so an invite cannot be used to enumerate a server.
      //
      // This reads `resource.data` rather than calling isServerMember(): for a
      // list query, a `get()` on the document being listed is both redundant
      // and a per-document billed read. `memberIds` is exactly what the
      // inbox query filters on, so Firestore can prove the query is safe.
      allow read: if isSignedIn() && uid() in resource.data.memberIds;

      // Create: you are the owner and the sole initial member.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'createdAt', 'updatedAt', 'channelIds', 'memberCount',
          'iconURL', 'schemaVersion', 'owner', 'memberIds', 'inviteCodes'
        ])
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 48
        && request.resource.data.memberCount == 1;

      // Update: admins may rename / add channels. Anyone joining through an
      // invite may append only themselves (checked below).
      allow update: if isSignedIn()
        && (
          // Admin path: rename, channel bookkeeping, icon.
          (isServerAdmin(serverId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 48
            // inviteCodes is the server's own invite registry, maintained by
            // admins as codes are minted and revoked.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'updatedAt', 'iconURL', 'channelIds', 'memberCount', 'inviteCodes']))
          ||
          // Self-join path: the ONLY change is adding the caller to memberIds
          // and bumping memberCount by one.
          (
            clientAddsOnlySelf(resource.data.memberIds, request.resource.data.memberIds)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.name == resource.data.name
            && request.resource.data.channelIds == resource.data.channelIds
            && request.resource.data.memberCount == resource.data.memberCount + 1
            // A joiner may ONLY add themselves. Without this, the same write
            // could also append to inviteCodes or rewrite the owner block.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'memberCount', 'updatedAt'])
          )
          ||
          // Self-leave path: the only change is removing the caller.
          (
            request.resource.data.memberIds.toSet()
              == resource.data.memberIds.toSet().difference([uid()].toSet())
            && request.resource.data.ownerId != uid()
            && request.resource.data.name == resource.data.name
            && request.resource.data.channelIds == resource.data.channelIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'memberCount', 'updatedAt'])
          )
        );

      // Deleting a server is the owner's call.
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/servers/$(serverId))
        && resource.data.ownerId == uid();

      /* ------------------------- membership ------------------------- */
      match /members/{memberId} {
        allow read: if isServerMember(serverId);

        // Joining: you may add yourself, but ONLY holding a valid, unrevoked
        // invite that targets this exact server. Without this check any
        // signed-in user who learned a server id could join it.
        //
        // The create is also an escalation guard: a self-join is always
        // `role == 'member'`, so nobody can write themselves in as an admin.
        // Two legitimate ways to appear here:
        //
        //   1. OWNER BOOTSTRAP. `createServer` writes the server, its first
        //      channel and the owner's member record in one batch, so there is
        //      no invite to present and a plain `get()` on the server would
        //      not see the uncommitted write. `getAfter()` does see it, and
        //      the owner role is self-authorising because it can only be
        //      claimed by the uid the server document already names.
        //   2. SELF-JOIN with a valid, unrevoked invite for THIS server.
        //
        // Either way the write is to your own record, and the role is fixed
        // by the branch - nobody can write themselves in as an 'admin'.
        allow create: if isSignedIn()
          && memberId == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.serverId == serverId
          && request.resource.data.keys().hasOnly([
            'serverId', 'uid', 'role', 'joinedAt', 'displayName', 'username',
            'photoURL', 'inviteCode'
          ])
          && (
            (request.resource.data.role == 'member'
              && isUsableServerInvite(request.resource.data.inviteCode, serverId))
            ||
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == uid())
          );

        // Only admins may change roles. `isServerAdmin` already implies a
        // signed-in caller; the explicit check makes that legible here and
        // short-circuits before any document reads.
        allow update: if isSignedIn()
          && isServerAdmin(serverId)
          && request.resource.data.role in ['owner', 'admin', 'member'];

        // Leave, or be removed by an admin. The owner cannot be removed.
        allow delete: if isSignedIn()
          && (
            adminRemovesMember(serverId, memberId)
            || (memberId == uid() && resource.data.role != 'owner')
          );
      }

      /* --------------------------- invites -------------------------- *
       * Legacy per-server invite records. The real invite registry is the
       * top-level `invites/{code}` collection (so a link resolves without
       * knowing its server); this nested block is kept closed: no client
       * writes, admins may read.
       */
      match /invites/{code} {
        allow read: if isSignedIn() && isServerAdmin(serverId);
        allow write: if isSignedIn() && isServerAdmin(serverId);
      }
    }

    /* ---------------------------------------------------------------- *
     * Invites — no expiry, revocable
     * ---------------------------------------------------------------- *
     * Invites live at the top level so a link can be resolved without first
     * knowing which server it belongs to. Reading an invite by code is
     * deliberately open to any signed-in user: that is what makes the link
     * work. It exposes only the target's name and type, never its contents.
     */
    match /invites/{code} {
      // `get` is open to any signed-in user: that is what makes a shared link
      // work without knowing its target.
      allow get: if isSignedIn();

      // `list` is deliberately NOT granted. Listing would reveal codes for
      // arbitrary targets - a directory of keys to every server - and the
      // admin screen does not use a query: it reads the target's `inviteCodes`
      // registry and fetches each invite directly. No unused permission is
      // left here, because an untested path is how holes ship.

      // Only owners/admins of the target may mint a link. Group invites check
      // the conversation's admin list instead of a server role.
      allow create: if isSignedIn()
        && code.size() >= 8
        && code.size() <= 24
        && request.resource.data.code == code
        && request.resource.data.createdBy == uid()
        && request.resource.data.expiresAt == null
        && request.resource.data.revoked == false
        && request.resource.data.uses == 0
        && request.resource.data.type in ['server', 'group']
        && (
          (request.resource.data.type == 'server'
            && isServerAdmin(request.resource.data.targetId))
          ||
          (request.resource.data.type == 'group'
            && uid() in get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.admins)
        );

      // `uses` is a courtesy counter, incremented by whoever joins. Nothing
      // is authorised by it, so a member may touch that one field.
      // Revocation is the creator's alone, and it is terminal: a revoked
      // invite can never be un-revoked (nobody can flip `revoked` back).
      allow update: if isSignedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.type == resource.data.type
        && (
          (resource.data.revoked == false
            && request.resource.data.revoked == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']))
          || (resource.data.createdBy == uid()
              && resource.data.revoked == false
              && request.resource.data.revoked == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt']))
        );

      allow delete: if isSignedIn() && resource.data.createdBy == uid();
    }

    /* ---------------------------------------------------------------- *
     * Conversations
     * ---------------------------------------------------------------- */
    match /conversations/{conversationId} {

      /* ------------------------- parent document -------------------- */
      allow read: if isMember(conversationId);

      // Creating a conversation: you must be a member and an admin of what
      // you create. Private chats have exactly two members; groups have 1+
      // others plus you.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'name', 'photoURL', 'color', 'createdBy', 'createdAt', 'updatedAt',
          'memberIds', 'members', 'admins', 'lastMessage', 'lastMessageAt', 'typing',
          'mutedBy', 'archivedBy', 'unreadCounts', 'lastReadAt', 'schemaVersion',
          'serverId', 'topic', 'inviteCodes'
        ])
        && request.resource.data.type in ['private', 'group', 'channel']
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.memberIds
        // A channel is a single room inside a server: it needs ONE member (it
        // can legitimately start as just its creator) and it has no per-channel
        // admins - authority lives on the server document. Chats and groups
        // keep the admin rule and the two-person minimum.
        && (
             (request.resource.data.type == 'channel'
               && request.resource.data.admins.size() == 0
               && request.resource.data.serverId is string
               && isServerAdmin(request.resource.data.serverId))
             ||
             (request.resource.data.type != 'channel'
               && uid() in request.resource.data.admins
               && request.resource.data.memberIds.size() >= 2)
           )
        && request.resource.data.memberIds.size() <= 64
        // A private conversation must be exactly you + one other person.
        && (request.resource.data.type != 'private'
            || request.resource.data.memberIds.size() == 2)
        && request.resource.data.members is map
        // Every declared member must have a member card.
        && request.resource.data.memberIds.toSet().difference(request.resource.data.members.keys().toSet()).size() == 0;

      // Updates: any member may update ordinary fields (unread counters, mute,
      // archive, typing markers, lastMessage). Structural changes are the only
      // ones that need privilege checks, and those are expressed as explicit
      // "unchanged OR privileged action" clauses below.
      allow update: if isMember(conversationId)
        // Immutable identity fields.
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        // Membership: either untouched, or changed by an admin (adds/removes),
        // or the caller is removing themselves (leave / delete chat).
        //
        // Channels are special: a join legitimately adds the caller via the
        // server invite path, so channels may grow by exactly the caller. A
        // channel must never be *shrunk* by a non-admin, which is what the
        // self-leave branch below would otherwise permit.
        && (
             request.resource.data.memberIds == resource.data.memberIds
             || (uid() in resource.data.admins
                 && uid() in request.resource.data.memberIds
                 && request.resource.data.memberIds.size() >= 2)
             || (!(uid() in request.resource.data.memberIds)
                 && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                 && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0)
             // Channels also grow by exactly the caller (a server join adds
             // them to every channel). The KEY detail is the user document:
             // `users/{uid}` always exists for a signed-in, onboarded account,
             // so reading it cannot fail the way reading a not-yet-created
             // server member record would. The code being checked is the one
             // this user most recently joined with.
             || (request.resource.data.type == 'channel'
                 && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                 && request.resource.data.memberIds.toSet()
                      == resource.data.memberIds.toSet().union([uid()].toSet())
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['memberIds', 'members', 'unreadCounts', 'lastReadAt', 'updatedAt', 'typing', 'mutedBy', 'archivedBy', 'lastMessage', 'lastMessageAt'])
                 && isUsableServerInvite(
                      get(/databases/$(database)/documents/users/$(uid())).data.lastInviteCode,
                      resource.data.serverId))
             // Group invites: same idea for a group chat. A group has no
             // server, so the check is that the invite names THIS
             // conversation and is still live.
             || (request.resource.data.type == 'group'
                 && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                 && request.resource.data.memberIds.toSet()
                      == resource.data.memberIds.toSet().union([uid()].toSet())
                 && isUsableGroupInvite(
                      get(/databases/$(database)/documents/users/$(uid())).data.lastInviteCode,
                      conversationId))
           )
        // A channel's name, server and type are structural: only admins change
        // them. Ordinary members can update unread/mute/mute-adjacent fields.
        && (
             request.resource.data.type != 'channel'
             || (
                  (request.resource.data.name == resource.data.name
                   && request.resource.data.serverId == resource.data.serverId)
                  || isServerAdmin(resource.data.serverId)
                )
           )
        // Admins: unchanged, or an existing admin made the change, or the
        // caller dropped their own admin flag by leaving.
        && (
             request.resource.data.admins == resource.data.admins
             || uid() in resource.data.admins
           )
        // The creator's admin flag can never be removed by anyone else.
        && (
             request.resource.data.createdBy != uid()
             || request.resource.data.createdBy in request.resource.data.admins
             || !(uid() in resource.data.admins)
           )
        // Every member must still have a member card (no dangling members).
        // Evaluated on the merged document, so dotted-path updates that don't
        // touch `members` still satisfy it when the data was consistent.
        && (
             !(request.resource.data.keys().hasAny(['members']))
             || request.resource.data.memberIds.toSet()
                  .difference(request.resource.data.members.keys().toSet())
                  .size() == 0
           )
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 48
        && request.resource.data.unreadCounts is map
        && (
             request.resource.data.lastMessage == null
             || (request.resource.data.lastMessage is map
                 && request.resource.data.lastMessage.text is string
                 && request.resource.data.lastMessage.text.size() <= 4100)
           );

      // Deleting: admins may delete a group; a server admin may delete one of
      // its channels; either member may delete a private chat.
      //
      // Channels have no per-channel admins, so the admin check has to be
      // against the SERVER - without this branch no channel could ever be
      // removed (the general rule was written before servers existed).
      allow delete: if isSignedIn()
        && isMember(conversationId)
        && (
          uid() in conversationData(conversationId).admins
          || (conversationData(conversationId).type == 'channel'
              && isServerAdmin(conversationData(conversationId).serverId))
        );

      /* ---------------------------- messages ------------------------ */
      match /messages/{messageId} {
        // Members can read history.
        allow read: if isMember(conversationId);

        // Append-only, with shape validation:
        //  - senderId must be you (no impersonation)
        //  - timestamps must be server-provided
        //  - text is bounded and typed
        //  - image payload (if any) must point at this project's bucket path
        allow create: if isMember(conversationId)
          && request.resource.data.senderId == uid()
          && request.resource.data.keys().hasOnly([
               'type', 'text', 'image', 'senderId', 'senderName', 'senderUsername',
               'senderPhotoURL', 'replyTo', 'createdAt', 'clientCreatedAt',
               'editedAt', 'deletedAt', 'deletedBy', 'reactions'
             ])
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (
               request.resource.data.type != 'image'
               || (request.resource.data.image is map
                   && request.resource.data.image.url is string
                   && request.resource.data.image.url.matches('^https://.*')
                   && request.resource.data.image.storagePath is string
                   && request.resource.data.image.storagePath.matches('^chat-images/.*'))
             )
          // Server timestamp required (clients cannot forge message times).
          // Optional tombstone fields must be absent on creation.
          && request.resource.data.createdAt == request.time
          && (!request.resource.data.keys().hasAny(['deletedAt', 'deletedBy', 'editedAt']));

        // Soft delete only (tombstone), by the sender or a group admin.
        // The diff must touch only tombstone fields, and the new values must
        // be exactly "deleted, by me, empty text".
        allow update: if isMember(conversationId)
          && (
               resource.data.senderId == uid()
               || isAdminOf(conversationId)
             )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deletedAt', 'deletedBy', 'text', 'image', 'replyTo'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['deletedAt', 'deletedBy'])
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == uid()
          && request.resource.data.text == '';

        // Hard delete: sender only (admins moderate via soft delete).
        allow delete: if isMember(conversationId)
          && resource.data.senderId == uid();
      }

      /* ------------------------- read cursors ----------------------- */
      match /reads/{userId} {
        // Any member can read cursors to compute receipts.
        allow read: if isMember(conversationId);

        // Only you can write your own cursor.
        allow write: if isMember(conversationId)
          && uid() == userId
          && request.resource.data.keys().hasOnly(['uid', 'lastReadAt', 'updatedAt'])
          && request.resource.data.uid == uid();

        // Removing a departed member's cursor is an admin action.
        allow delete: if isSignedIn()
          && (uid() == userId || isAdminOf(conversationId));
      }

      /* ---------------------- typing indicators --------------------- */
      match /typing/{userId} {
        allow read: if isMember(conversationId);

        allow create, update: if isMember(conversationId)
          && uid() == userId
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'expiresAt'])
          && request.resource.data.uid == uid()
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60;

        allow delete: if isSignedIn()
          && (uid() == userId || isAdminOf(conversationId));
      }

      /* ------------------------- catch-all -------------------------- */
      match /{document=**} {
        allow read, write: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     * Anything not matched above is denied.
     * ---------------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
