# ============================================================================
# CHAZTER — environment template
# ----------------------------------------------------------------------------
# Copy to `.env.local` and fill in your own Firebase project's web config.
# These values are PUBLIC (they ship to the browser). They are not secrets.
# NEVER put a service-account key, Admin SDK credential or private key here.
#
# The app works without this file: src/lib/firebase/config.js contains the
# Chazter demo project defaults.
# ============================================================================

# Firebase web config — Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Use the local Firebase emulator suite (Auth :9099, Firestore :8080)
VITE_USE_FIREBASE_EMULATORS=false

# Build-time base path. Leave "/" for Firebase Hosting / custom domains.
# Use "/<repository-name>/" for GitHub Pages project sites, e.g. "/chazter/".
VITE_BASE_PATH=/
